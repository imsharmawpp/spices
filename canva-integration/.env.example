# ---------------------------------------------------------------------------
# Canva Connect integration credentials
# Copy this file to `.env` and fill in the values from the Canva Developer
# Portal: https://www.canva.com/developers/integrations
# ---------------------------------------------------------------------------

# Your integration's Client ID (Configure page -> Credentials)
CANVA_CLIENT_ID=

# Your integration's Client secret (Configure page -> Generate secret).
# Begins with "cnvca". You can only view this once, so store it safely.
CANVA_CLIENT_SECRET=

# A redirect URL you added under Authentication -> Authorized redirects.
# For this headless/CLI flow use a loopback URL (localhost is NOT allowed):
CANVA_REDIRECT_URI=http://127.0.0.1:8910/callback

# Space-separated scopes. These cover create + export + asset upload + brand
# templates (the brandtemplate:* scopes are needed for autofill discovery).
CANVA_SCOPES=design:content:read design:content:write design:meta:read asset:read asset:write profile:read brandtemplate:meta:read brandtemplate:content:read

# ---------------------------------------------------------------------------
# Image generation options (used by `npm run generate`)
# ---------------------------------------------------------------------------

# MODE controls how the 3 product images are produced:
#   autofill -> fill a Brand Template (best output; needs Canva Enterprise/trial)
#   asset    -> upload a base photo per product, drop it in a design, export PNG
#   blank    -> create blank custom designs and export (pipeline smoke-test only)
CANVA_GENERATE_MODE=asset

# For MODE=autofill: the Brand Template ID and the dataset field names.
CANVA_BRAND_TEMPLATE_ID=

# Export size (pixels) for the product images.
CANVA_IMAGE_WIDTH=1080
CANVA_IMAGE_HEIGHT=1080
