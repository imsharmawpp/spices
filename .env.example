APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true

# Database driver: sqlite (default, zero-config for local dev) or mysql (production)
DB_DRIVER=sqlite
# For sqlite: path is relative to project root
DB_SQLITE_PATH=storage/database.sqlite

# For mysql (production) — see docs/04-database-schema.md
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spices
DB_USER=spices
DB_PASS=

CURRENCY=USD
CURRENCY_SYMBOL=$

MAIL_FROM="Saffra Spices <no-reply@example.com>"
PAYMENT_PROVIDER=mock
