APP_ENV=production
APP_URL=https://your-domain-or-subdomain.com
APP_DEBUG=false

# Sub-folder deployments only (recommended: deploy at a domain/sub-domain root and leave blank)
APP_BASE=

# ---------------------------------------------------------------------------
# Database
# Driver: "mysql" (production / shared hosting) or "sqlite" (local demo).
# DB_FALLBACK_SQLITE=true lets the app fall back to SQLite when MySQL is
# unreachable (handy for local dev). Set to false in production so DB errors
# surface instead of silently using an empty SQLite file.
# ---------------------------------------------------------------------------
DB_DRIVER=mysql
DB_FALLBACK_SQLITE=false

# MySQL (from your hosting control panel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# SQLite fallback path (local dev)
DB_SQLITE_PATH=storage/database.sqlite

CURRENCY=INR
CURRENCY_SYMBOL=₹

MAIL_FROM="Saffra Spices <no-reply@example.com>"
PAYMENT_PROVIDER=mock
