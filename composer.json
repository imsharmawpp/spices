{
    "name": "saffra/spices-store",
    "description": "Saffra Spices — D2C e-commerce store (HTML/CSS/JS frontend, PHP + SQL backend).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "migrate": "php database/migrate.php",
        "serve": "php -S 127.0.0.1:8000 -t public public/index.php"
    },
    "config": {
        "sort-packages": true
    }
}
